# ---- Mode ----
# paper = simulated money on real prices (recommended to start). live = real orders.
MODE=paper
EXCHANGE=binance
SYMBOLS=BTC/USDT,ETH/USDT
TIMEFRAME=1h

# ---- Live / sandbox only ----
API_KEY=
API_SECRET=
# SANDBOX=true runs live mode against the exchange testnet (fake money, real order flow).
SANDBOX=false
# Required for live mode with real money (not needed for SANDBOX=true):
LIVE_CONFIRM=

# ---- Paper trading ----
STARTING_BALANCE=1000
FEE_RATE=0.001

# ---- Strategy ----
BUY_THRESHOLD=0.60
SELL_THRESHOLD=0.45
RETRAIN_HOURS=12

# ---- Risk ----
RISK_PER_TRADE=0.01
MAX_POSITION_PCT=0.30
MAX_OPEN_POSITIONS=3
STOP_LOSS_ATR=2.0
TAKE_PROFIT_ATR=4.0
MAX_DRAWDOWN_PCT=0.20
DAILY_LOSS_LIMIT_PCT=0.05
# For tiny accounts: buy the exchange's minimum order size when risk-based sizing
# would be below it. This risks a larger share of the account per trade.
SMALL_ACCOUNT_MODE=false

# ---- Private dashboard (python -m grgtrading dashboard) ----
DASHBOARD_PORT=8080
# Leave empty: you create the password the first time you open the dashboard.
DASHBOARD_PASSWORD=
# Name shown on the dashboard and in the bots list (default: the machine's hostname).
BOT_NAME=

# ---- Telegram notifications (optional) ----
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
